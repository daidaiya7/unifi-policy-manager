<Window x:Class="UniFiDnsManager.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS 记录" Width="620" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/UniFi.ico">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="DNS RECORD" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="HeadingText" Text="新增 DNS 记录" FontSize="23" FontWeight="Bold" Margin="0,3,0,20"/>

            <TextBlock Text="记录类型" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeComboBox" SelectionChanged="TypeComboBox_SelectionChanged">
                <ComboBoxItem Content="转发域名" Tag="NS"/><ComboBoxItem Content="主机 (A)" Tag="A"/><ComboBoxItem Content="主机 (AAAA)" Tag="AAAA"/>
                <ComboBoxItem Content="别名 (CNAME)" Tag="CNAME"/><ComboBoxItem Content="邮件 (MX)" Tag="MX"/><ComboBoxItem Content="文本 (TXT)" Tag="TXT"/><ComboBoxItem Content="服务 (SRV)" Tag="SRV"/>
            </ComboBox>

            <StackPanel x:Name="StandardFieldsPanel" Margin="0,15,0,0">
                <TextBlock x:Name="KeyLabel" Text="域名" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="KeyTextBox"/>
                <TextBlock x:Name="ValueLabel" Text="值" FontWeight="SemiBold" Margin="0,13,0,6"/>
                <TextBox x:Name="ValueTextBox"/>
            </StackPanel>

            <StackPanel x:Name="TxtFieldsPanel" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="域名" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtKeyTextBox"/>
                <TextBlock Text="文本" FontWeight="SemiBold" Margin="0,13,0,6"/>
                <TextBox x:Name="TxtValueTextBox" Height="145" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="1024"/>
                <TextBlock Text="最多 4 段，每段 255 个字符；含逗号的行需用双引号包裹。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid x:Name="SrvFieldsPanel" Visibility="Collapsed" Margin="0,15,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="域名" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvDomainTextBox"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="服务器" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvServerTextBox"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,8,12"><TextBlock Text="服务（例如 _ldap）" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvServiceTextBox"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="协议（例如 _tcp）" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvProtocolTextBox"/></StackPanel>
                <Grid Grid.Row="3" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="端口" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvPortTextBox"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvPriorityTextBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="权重" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SrvWeightTextBox" Text="0"/></StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="TtlPanel" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TTL" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <RadioButton x:Name="AutoTtlRadio" Content="自动" GroupName="ttl" IsChecked="True" VerticalAlignment="Center" Checked="TtlRadio_Checked"/>
                    <RadioButton x:Name="ManualTtlRadio" Content="手动" GroupName="ttl" Margin="16,0,10,0" VerticalAlignment="Center" Checked="TtlRadio_Checked"/>
                    <TextBox x:Name="TtlTextBox" Width="110" Text="300" IsEnabled="False"/>
                    <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PriorityPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="PriorityTextBox" Text="0"/>
            </StackPanel>

            <CheckBox x:Name="EnabledCheckBox" Content="启用此记录" IsChecked="True" Margin="0,18,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Width="90" Click="CancelButton_Click"/>
                <Button Content="保存" Width="105" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
