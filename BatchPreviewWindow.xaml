<Window x:Class="UniFiDnsManager.BatchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作预览" Width="720" Height="680" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/UniFi.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="REVIEW BEFORE APPLY" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="HeadingText" Text="操作预览" FontSize="23" FontWeight="Bold" Margin="0,3,0,4"/>
            <TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,14">
            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock x:Name="Metric1Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric1Value" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="5,0"><StackPanel><TextBlock x:Name="Metric2Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric2Value" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="5,0"><StackPanel><TextBlock x:Name="Metric3Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric3Value" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock x:Name="Metric4Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric4Value" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox x:Name="PrimaryGroup" Header="将执行" Margin="0,0,0,10">
                    <ListBox x:Name="PrimaryList" MaxHeight="250" FontFamily="Consolas"/>
                </GroupBox>
                <GroupBox x:Name="ExistingGroup" Header="已存在，将跳过" Margin="0,0,0,10">
                    <ListBox x:Name="ExistingList" MaxHeight="150" FontFamily="Consolas"/>
                </GroupBox>
                <GroupBox x:Name="InvalidGroup" Header="无效项目">
                    <ListBox x:Name="InvalidList" MaxHeight="150" FontFamily="Consolas"/>
                </GroupBox>
                <Border x:Name="WarningBorder" Background="#FFF8E6" BorderBrush="#F2D99E" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                    <TextBlock x:Name="WarningText" Foreground="#8B5B08" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <CheckBox x:Name="ConfirmCheckBox" Content="我已检查上述清单，确认执行" VerticalAlignment="Center" Checked="ConfirmCheckBox_Changed" Unchecked="ConfirmCheckBox_Changed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Click="CancelButton_Click"/>
                <Button x:Name="ApplyButton" Content="执行" Width="120" IsEnabled="False" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
