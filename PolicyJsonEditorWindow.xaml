<Window x:Class="UniFiDnsManager.PolicyJsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="策略编辑器" Width="980" Height="760" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/UniFi.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="CategoryText" Text="OFFICIAL POLICY API" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="HeadingText" Text="编辑策略" FontSize="23" FontWeight="Bold" Margin="0,3,0,4"/>
                <TextBlock Text="请求体严格按照 UniFi Network 官方 OpenAPI。只读字段 id、index、metadata 会自动移除。" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel x:Name="TemplatePanel" Grid.Column="1" Width="220">
                <TextBlock Text="创建模板" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="TemplateComboBox" SelectionChanged="TemplateComboBox_SelectionChanged">
                    <ComboBoxItem Content="IPv4 ACL" Tag="IPV4" IsSelected="True"/>
                    <ComboBoxItem Content="MAC ACL" Tag="MAC"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F7FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="参考 UUID" FontWeight="Bold" VerticalAlignment="Top" Margin="0,4,14,0"/>
                <ListBox x:Name="ReferencesListBox" Grid.Column="1" Height="82" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11"
                         MouseDoubleClick="ReferencesListBox_MouseDoubleClick" ToolTip="双击复制 UUID">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Id}"/></TextBlock></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBox x:Name="JsonTextBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top" Padding="12"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="新策略模板默认停用；确认引用 UUID 和匹配条件后再启用。" Foreground="#A25A00" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="格式化 JSON" Width="110" Click="FormatButton_Click"/>
                <Button Content="取消" Width="90" Margin="9,0,0,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="保存" Width="105" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
